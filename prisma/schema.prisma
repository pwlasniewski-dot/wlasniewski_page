// ============================================================
// FOTO-MATCH (waitlist MVP)
// Pierwszy moduł nowego produktu — na razie tylko zbieramy zapisy.
// Cala konfiguracja kanonicznego URL-a (canonical / OG / linki w mailach)
// idzie przez NEXT_PUBLIC_FOTO_MATCH_URL — jeden ENV pozwala
// przeniesc moduł na osobną domenę (foto-match.pl) bez ruszania kodu.
// ============================================================
model FotoMatchWaitlist {
  id                    Int       @id @default(autoincrement())
  email                 String    @unique
  city                  String?
  role                  String? // 'inviter' | 'invitee' | 'both' | null
  age_range             String? // np. '25-34'
  source                String? // utm_source / referrer
  marketing_opt_in      Boolean   @default(false)
  rules_accepted_at     DateTime?
  ip_address            String?
  user_agent            String?
  confirm_token         String?   @unique
  confirm_token_expires DateTime?
  confirmed_at          DateTime?
  unsubscribed_at       DateTime?
  notes                 String?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  @@index([city])
  @@index([confirmed_at])
  @@index([created_at])
  @@map("foto_match_waitlist")
}

// ============================================================
// FOTO-MATCH — PROFIL UŻYTKOWNIKA (Faza 1)
// 1:1 z User (klient z CRM, jedna kartoteka). Brak profilu = po prostu klient,
// który nie zarejestrował się do Foto-Match — nie widać go w panelu Foto-Match.
// ============================================================
model FotoMatchProfile {
  id               Int       @id @default(autoincrement())
  user_id          Int       @unique
  user             User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // Profil podstawowy
  display_name     String    @db.VarChar(60)
  birth_year       Int
  gender           String    @db.VarChar(20)  // male | female | other
  city             String    @db.VarChar(60)
  radius_km        Int       @default(30)
  latitude         Float?
  longitude        Float?
  bio              String?   @db.Text
  interests        String[]  @default([])
  experience       String?   @db.VarChar(40)  // never_modeled | few_times | experienced
  comfort_level    String?   @db.VarChar(40)  // shy | neutral | open

  // Weryfikacja tożsamości (manual przez admina)
  selfie_url       String?
  id_doc_url       String?  // DEPRECATED (RODO data minimization) — pozostawione nullable dla starych rekordów
  verified_at      DateTime?
  verified_by      Int?
  rejection_reason String?

  // Weryfikacja numeru telefonu (zastępuje skan dowodu — RODO data minimization)
  phone                          String?   @db.VarChar(20)
  phone_verified_at              DateTime?
  phone_verification_code_hash   String?   @db.VarChar(120)
  phone_verification_expires_at  DateTime?
  phone_verification_attempts    Int       @default(0)

  // Oświadczenie pełnoletności (zamiast skanu dowodu)
  age_declared_at  DateTime?
  age_declared_ip  String?   @db.VarChar(64)

  // Moderacja / status
  status           String    @default("PENDING") @db.VarChar(20)
  // PENDING (po onboardingu) -> ACTIVE (po akceptacji admina) | SUSPENDED | DELETED
  is_active        Boolean   @default(false)
  flagged_count    Int       @default(0)

  // Metryki
  last_active      DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  photos           FotoMatchPhoto[]
  referrals_sent     FotoMatchReferral[] @relation("ReferralsByMe")
  referrals_received FotoMatchReferral[] @relation("ReferralsToMe")
  swipes_sent      FotoMatchSwipe[]    @relation("SwipesByMe")
  swipes_received  FotoMatchSwipe[]    @relation("SwipesToMe")
  blocks_sent      FotoMatchBlock[]    @relation("BlocksByMe")
  blocks_received  FotoMatchBlock[]    @relation("BlocksToMe")
  reports_sent     FotoMatchReport[]   @relation("ReportsByMe")
  reports_received FotoMatchReport[]   @relation("ReportsToMe")
  messages_sent    FotoMatchMessage[]  @relation("MessagesByMe")
  messages_received FotoMatchMessage[] @relation("MessagesToMe")

  @@index([status])
  @@index([city])
  @@index([is_active])
  @@index([created_at])
  @@index([last_active])
  @@index([status, is_active, city])
  @@map("foto_match_profile")
}

// ============================================================
// ZDJĘCIA PROFILOWE (3-6 per profil)
// Po uploadzie idzie auto-moderacja AWS Rekognition; flagged trafia do admina.
// ============================================================
model FotoMatchPhoto {
  id              Int               @id @default(autoincrement())
  profile_id      Int
  profile         FotoMatchProfile  @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  url             String
  position        Int               @default(0)  // 0 = main

  // AI moderacja
  ai_status       String            @default("PENDING") @db.VarChar(20)
  // PENDING | APPROVED | FLAGGED | REJECTED
  ai_labels       Json?
  ai_flagged_for  String?

  // Manual review
  reviewed_by     Int?
  reviewed_at     DateTime?
  review_notes    String?

  created_at      DateTime          @default(now())

  @@index([profile_id])
  @@index([ai_status])
  @@map("foto_match_photo")
}

// ============================================================
// MATCH SETTINGS — singleton, admin steruje 15 cechami filtrującymi
// + bonus referralowy (kwota/procent/typ).
// ============================================================
model FotoMatchMatchSettings {
  id                            Int      @id @default(autoincrement())

  opposite_gender_only          Boolean  @default(false)
  same_gender_only              Boolean  @default(false)

  same_city                     Boolean  @default(false)
  respect_search_radius         Boolean  @default(false)

  age_range                     Boolean  @default(false)
  age_range_years               Int      @default(5)

  min_shared_interests          Boolean  @default(false)
  min_shared_interests_count    Int      @default(2)

  same_experience_level         Boolean  @default(false)
  complementary_experience      Boolean  @default(false)
  same_comfort_level            Boolean  @default(false)

  verified_only                 Boolean  @default(false)
  min_photos                    Boolean  @default(false)
  min_photos_count              Int      @default(3)
  no_flagged_photos             Boolean  @default(false)

  recently_active               Boolean  @default(false)
  recently_active_days          Int      @default(30)

  exclude_already_seen          Boolean  @default(false)
  exclude_already_matched       Boolean  @default(false)

  // Bonus referralowy
  referral_bonus_enabled        Boolean  @default(false)
  referral_bonus_amount_grosze  Int      @default(5000)
  referral_bonus_percent        Int      @default(10)
  referral_bonus_type           String   @default("AMOUNT") @db.VarChar(20)
  referral_bonus_min_to_redeem  Int      @default(1)
  referral_bonus_expires_days   Int      @default(90)

  updated_at                    DateTime @updatedAt
  updated_by                    Int?

  @@map("foto_match_match_settings")
}

// ============================================================
// REFERRAL — polec parę / znajomego, dostań rabat po jego rejestracji.
// Przygotowane pod FB / IG / WhatsApp share (invite_token w URL + OG image).
// ============================================================
model FotoMatchReferral {
  id                    Int       @id @default(autoincrement())

  referrer_profile_id   Int
  referrer              FotoMatchProfile @relation("ReferralsByMe", fields: [referrer_profile_id], references: [id], onDelete: Cascade)

  invited_email         String?   @db.VarChar(255)
  invited_user_id       Int?
  invited_profile_id    Int?
  invited_profile       FotoMatchProfile? @relation("ReferralsToMe", fields: [invited_profile_id], references: [id], onDelete: SetNull)

  status                String    @default("PENDING") @db.VarChar(20)
  // PENDING | REGISTERED | ACTIVE | REWARDED | EXPIRED | CANCELED

  reward_amount_grosze  Int?
  reward_percent        Int?
  reward_type           String?   @db.VarChar(20)
  reward_voucher_code   String?   @unique @db.VarChar(40)
  reward_expires_at     DateTime?
  reward_redeemed_at    DateTime?
  reward_redeemed_for   String?   @db.VarChar(40)

  invite_token          String    @unique @db.VarChar(64)
  share_count           Int       @default(0)
  click_count           Int       @default(0)

  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  @@index([referrer_profile_id])
  @@index([status])
  @@index([invited_email])
  @@index([invite_token])
  @@map("foto_match_referral")
}

// ============================================================
// SWIPE / LIKE / SKIP
// from_profile -> to_profile, action: LIKE | SKIP | SUPER_LIKE | REPORT
// MATCH = pair LIKE w obie strony (denormalizowane przez `is_match`).
// ============================================================
model FotoMatchSwipe {
  id              Int       @id @default(autoincrement())
  from_profile_id Int
  to_profile_id   Int
  from_profile    FotoMatchProfile @relation("SwipesByMe", fields: [from_profile_id], references: [id], onDelete: Cascade)
  to_profile      FotoMatchProfile @relation("SwipesToMe", fields: [to_profile_id], references: [id], onDelete: Cascade)

  action          String    @db.VarChar(20)  // LIKE | SKIP | SUPER_LIKE
  is_match        Boolean   @default(false)
  matched_at      DateTime?

  created_at      DateTime  @default(now())

  @@unique([from_profile_id, to_profile_id])
  @@index([from_profile_id, action])
  @@index([to_profile_id, action])
  @@index([is_match])
  @@map("foto_match_swipe")
}

// ============================================================
// BLOCK — wzajemne blokady, wykluczane w discover/swipe.
// ============================================================
model FotoMatchBlock {
  id              Int       @id @default(autoincrement())
  blocker_id      Int
  blocked_id      Int
  blocker         FotoMatchProfile @relation("BlocksByMe", fields: [blocker_id], references: [id], onDelete: Cascade)
  blocked         FotoMatchProfile @relation("BlocksToMe", fields: [blocked_id], references: [id], onDelete: Cascade)
  reason          String?   @db.VarChar(255)
  created_at      DateTime  @default(now())

  @@unique([blocker_id, blocked_id])
  @@index([blocker_id])
  @@index([blocked_id])
  @@map("foto_match_block")
}

// ============================================================
// REPORT — zgłoszenia (wulgarność / oszustwo / fake / inne).
// ============================================================
model FotoMatchReport {
  id              Int       @id @default(autoincrement())
  reporter_id     Int
  reported_id     Int
  reporter        FotoMatchProfile @relation("ReportsByMe", fields: [reporter_id], references: [id], onDelete: Cascade)
  reported        FotoMatchProfile @relation("ReportsToMe", fields: [reported_id], references: [id], onDelete: Cascade)
  category        String    @db.VarChar(40)  // FAKE | INAPPROPRIATE | HARASSMENT | SPAM | OTHER
  description     String?   @db.Text
  status          String    @default("PENDING") @db.VarChar(20)  // PENDING | REVIEWING | RESOLVED | DISMISSED
  admin_note      String?   @db.Text
  resolved_by     Int?
  resolved_at     DateTime?
  created_at      DateTime  @default(now())

  @@index([status])
  @@index([reported_id])
  @@index([reporter_id])
  @@map("foto_match_report")
}

// ============================================================
// MESSAGE — wiadomości po MATCH. Tylko między profilami w MATCH.
// ============================================================
model FotoMatchMessage {
  id              Int       @id @default(autoincrement())
  from_profile_id Int
  to_profile_id   Int
  from_profile    FotoMatchProfile @relation("MessagesByMe", fields: [from_profile_id], references: [id], onDelete: Cascade)
  to_profile      FotoMatchProfile @relation("MessagesToMe", fields: [to_profile_id], references: [id], onDelete: Cascade)
  body            String    @db.Text
  read_at         DateTime?
  created_at      DateTime  @default(now())

  @@index([from_profile_id, to_profile_id])
  @@index([to_profile_id, read_at])
  @@map("foto_match_message")
}

// ============================================================
// CONSENT — Model Release. Per profil, kategorie zgody.
// Tworzony po zaakceptowaniu match-pair przed sesją.
// ============================================================
model FotoMatchSessionConsent {
  id                  Int       @id @default(autoincrement())
  profile_id          Int
  match_partner_id    Int       // profile_id drugiej osoby z match-pair
  booking_id          Int?      // opcjonalnie powiązane z konkretnym bookingiem
  consent_publish     Boolean   @default(false)
  consent_portfolio   Boolean   @default(false)
  consent_marketing   Boolean   @default(false)
  signed_at           DateTime  @default(now())
  signed_ip           String?   @db.VarChar(64)
  withdrawn_at        DateTime?
  withdrawn_reason    String?   @db.Text

  @@index([profile_id])
  @@index([match_partner_id])
  @@index([booking_id])
  @@map("foto_match_session_consent")
}

// ============================================================
// COMPLAINT — reklamacja klienta na sesję / booking.
// ============================================================
model BookingComplaint {
  id                  Int       @id @default(autoincrement())
  booking_id          Int
  booking             Booking   @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  client_email        String    @db.VarChar(255)
  category            String    @db.VarChar(40)  // QUALITY | DELAY | NO_SHOW | OTHER
  body                String    @db.Text
  status              String    @default("PENDING") @db.VarChar(20)  // PENDING | RESPONDED | RESOLVED | REJECTED
  admin_response      String?   @db.Text
  responded_at        DateTime?
  responded_by        Int?
  refund_offered      Int?      // grosze
  refund_accepted     Boolean?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  @@index([booking_id])
  @@index([status])
  @@index([client_email])
  @@map("booking_complaint")
}
