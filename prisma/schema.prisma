generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id             Int            @id @default(autoincrement())
  email          String         @unique
  password_hash  String
  name           String?
  role           String         @default("ADMIN")
  created_at     DateTime       @default(now())
  last_login     DateTime?
  blog_posts     BlogPost[]
  uploaded_media MediaLibrary[]

  @@map("admin_users")
}

model Setting {
  id                                Int      @id @default(autoincrement())
  setting_key                       String   @unique
  setting_value                     String?
  updated_at                        DateTime @default(now()) @updatedAt
  parallax_home_1                   String?  @default("")
  parallax_home_2                   String?  @default("")
  about_me_hero_image               String?  @default("")
  about_me_portrait                 String?  @default("")
  info_band_image                   String?  @default("")
  info_band_title                   String?
  info_band_content                 String?
  exit_popup_enabled                Boolean? @default(false)
  exit_popup_title                  String?
  exit_popup_content                String?
  exit_popup_cta_text               String?
  exit_popup_cta_link               String?
  navbar_layout                     String?  @default("logo_left_menu_right")
  navbar_sticky                     Boolean  @default(true)
  favicon_url                       String?
  smtp_host                         String?
  smtp_port                         Int?
  smtp_user                         String?
  smtp_password                     String?
  smtp_from                         String?
  logo_dark_url                     String?
  logo_size                         Int      @default(140)
  logo_url                          String?
  navbar_font_family                String   @default("Montserrat")
  navbar_font_size                  Int      @default(16)
  p24_api_key                       String?
  p24_crc_key                       String?
  p24_merchant_id                   String?
  p24_method_blik                   Boolean  @default(true)
  p24_method_card                   Boolean  @default(true)
  p24_method_transfer               Boolean  @default(true)
  p24_pos_id                        String?
  p24_test_mode                     Boolean  @default(true)
  payu_client_id                    String?
  payu_client_secret                String?
  payu_environment                  String   @default("sandbox")
  payu_merchant_pos_id              String?
  payu_md5_key                      String?
  payu_notify_url                   String?
  portfolio_categories              String?
  seasonal_effect                   String?  @default("none")
  stripe_publishable_key            String?
  stripe_secret_key                 String?
  stripe_webhook_secret             String?
  booking_currency                  String   @default("PLN")
  booking_min_days_ahead            Int      @default(7)
  booking_payment_method            String   @default("stripe")
  booking_require_payment           Boolean  @default(false)
  booking_terms_url                 String?
  navbar_transparent                Boolean  @default(false)
  facebook_pixel_id                 String?
  gift_card_promo_enabled           Boolean  @default(false)
  google_analytics_id               String?
  google_tag_manager_id             String?
  meta_verification_facebook        String?
  meta_verification_google          String?
  promo_code_discount_amount        Int?     @default(10)
  promo_code_discount_enabled       Boolean  @default(false)
  promo_code_discount_type          String?  @default("percentage")
  social_proof_total_clients        Int?     @default(100)
  urgency_enabled                   Boolean  @default(false)
  urgency_month                     String?
  urgency_slots_remaining           Int?
  gift_card_promo_description       String?
  gift_card_promo_rotation_interval Int?     @default(5)
  gift_card_promo_title             String?  @default("Karty Podarunkowe")
  gift_card_hero_image              String?
  portfolio_layout                  String?  @default("slider")
  gift_card_hero_opacity            Float?   @default(0.6)
  social_proof_enabled              Boolean  @default(true)
  theme_mode                        String   @default("dark")
  b2b_google_analytics_id           String?
  b2b_google_tag_manager_id         String?
  b2b_facebook_pixel_id             String?
  foto_match_enabled                Boolean  @default(false)
  cancellation_full_refund_days     Int      @default(7)
  cancellation_partial_days         Int      @default(3)
  cancellation_partial_pct          Int      @default(50)

  // Split payment 50/50 (globalny toggle + procent zaliczki)
  split_payment_enabled              Boolean @default(false)
  split_payment_deposit_percent      Int     @default(50)
  split_payment_remaining_due_days   Int     @default(7)

  @@map("settings")
}

model HistoryPhoto {
  id        String   @id @default(uuid())
  url       String
  filename  String
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@map("history_photos")
}

model MenuItem {
  id         Int        @id @default(autoincrement())
  title      String
  url        String?
  page_id    Int?
  parent_id  Int?
  order      Int        @default(0)
  is_active  Boolean    @default(true)
  menu_type  String     @default("b2c")
  created_at DateTime   @default(now())
  page       Page?      @relation(fields: [page_id], references: [id])
  parent     MenuItem?  @relation("MenuHierarchy", fields: [parent_id], references: [id])
  children   MenuItem[] @relation("MenuHierarchy")

  @@map("menu_items")
}

model MediaLibrary {
  id                      Int                @id @default(autoincrement())
  file_name               String
  original_name           String
  file_path               String
  file_size               BigInt
  mime_type               String
  width                   Int?
  height                  Int?
  folder                  String
  category                String?
  tags                    String?
  alt_text                String?
  webp_path               String?
  avif_path               String?
  thumbnail_path          String?
  used_in                 String?
  is_featured             Boolean            @default(false)
  uploaded_by             Int?
  created_at              DateTime           @default(now())
  blog_featured           BlogPost[]
  challenge_photos        ChallengePhoto[]
  hero_before_slides      HeroSlide[]        @relation("HeroBeforeImage")
  hero_slides             HeroSlide[]
  uploader                AdminUser?         @relation(fields: [uploaded_by], references: [id])
  portfolio_covers        PortfolioSession[]
  portfolio_mobile_covers PortfolioSession[] @relation("MobileCover")
  testimonial_photos      Testimonial[]

  @@map("media_library")
}

model PortfolioSession {
  id                    Int           @id @default(autoincrement())
  title                 String
  slug                  String        @unique
  category              String
  description           String?
  location              String?
  session_date          DateTime?
  cover_image_id        Int?
  media_ids             String?
  meta_title            String?
  meta_description      String?
  is_published          Boolean       @default(false)
  display_order         Int           @default(0)
  created_at            DateTime      @default(now())
  updated_at            DateTime      @default(now()) @updatedAt
  highlighted_media_ids String?
  is_category_hero      Boolean       @default(false)
  cover_image_mobile_id Int?
  cover_image           MediaLibrary? @relation(fields: [cover_image_id], references: [id])
  mobile_cover_image    MediaLibrary? @relation("MobileCover", fields: [cover_image_mobile_id], references: [id])

  @@map("portfolio_sessions")
}

model BlogPost {
  id                Int           @id @default(autoincrement())
  title             String
  slug              String        @unique
  excerpt           String?
  content           String
  featured_image_id Int?
  meta_title        String?
  meta_description  String?
  keywords          String?
  category          String?
  tags              String?
  status            String        @default("draft")
  published_at      DateTime?
  author_id         Int?
  created_at        DateTime      @default(now())
  updated_at        DateTime      @default(now()) @updatedAt
  author            AdminUser?    @relation(fields: [author_id], references: [id])
  featured_image    MediaLibrary? @relation(fields: [featured_image_id], references: [id])

  @@map("blog_posts")
}

model Testimonial {
  id                   Int           @id @default(autoincrement())
  client_name          String
  client_photo_id      Int?
  testimonial_text     String
  rating               Int?
  source               String?
  photo_size           Int?          @default(80)
  is_featured          Boolean       @default(false)
  show_on_booking_page Boolean       @default(false)
  display_order        Int           @default(0)
  created_at           DateTime      @default(now())
  client_photo         MediaLibrary? @relation(fields: [client_photo_id], references: [id])

  @@map("testimonials")
}

model PromoCode {
  id                       Int       @id @default(autoincrement())
  code                     String    @unique
  discount_value           Int
  discount_type            String
  valid_from               DateTime  @default(now())
  valid_until              DateTime?
  is_active                Boolean   @default(true)
  max_usage                Int?
  usage_count              Int       @default(0)
  auto_generated_for_email String?
  created_at               DateTime  @default(now())

  @@map("promo_codes")
}

model Inquiry {
  id             Int       @id @default(autoincrement())
  name           String
  email          String
  phone          String?
  message        String
  session_type   String?
  preferred_date DateTime?
  promo_code     String?
  source         String?
  status         String    @default("new")
  notes          String?
  created_at     DateTime  @default(now())

  @@map("inquiries")
}

model EmailSubscriber {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  source          String
  promo_code_sent String?
  is_active       Boolean  @default(true)
  subscribed_at   DateTime @default(now())

  @@map("email_subscribers")
}

model AnalyticsEvent {
  id           Int      @id @default(autoincrement())
  event_type   String
  page_url     String?
  user_id      String
  session_id   String
  referrer     String?
  utm_source   String?
  utm_medium   String?
  utm_campaign String?
  metadata     String?
  created_at   DateTime @default(now())

  @@index([event_type])
  @@index([created_at])
  @@index([session_id])
  @@map("analytics_events")
}

model HeroSlide {
  id              Int           @id @default(autoincrement())
  title           String?
  subtitle        String?
  button_text     String?
  button_link     String?
  image_id        Int
  display_order   Int           @default(0)
  display_mode    String        @default("BOTH")
  is_active       Boolean       @default(true)
  is_before_after Boolean       @default(false)
  before_image_id Int?
  created_at      DateTime      @default(now())
  before_image    MediaLibrary? @relation("HeroBeforeImage", fields: [before_image_id], references: [id])
  image           MediaLibrary  @relation(fields: [image_id], references: [id])

  @@map("hero_slides")
}

model Page {
  id                Int        @id @default(autoincrement())
  slug              String     @unique
  title             String
  content           String
  meta_title        String?
  meta_description  String?
  is_published      Boolean    @default(false)
  updated_at        DateTime   @default(now()) @updatedAt
  hero_image        String?
  hero_subtitle     String?
  content_images    String?
  parallax_sections String?
  content_cards     String?
  about_photo       String?
  about_text_side   String?
  home_sections     String?
  meta_keywords     String?
  page_type         String     @default("regular")
  sections          String?
  is_in_menu        Boolean    @default(false)
  menu_title        String?
  menu_order        Int        @default(0)
  parent_page_id    Int?
  menu_items        MenuItem[]
  parent_page       Page?      @relation("PageChildren", fields: [parent_page_id], references: [id])
  children          Page[]     @relation("PageChildren")

  @@map("pages")
}

model Booking {
  id                Int      @id @default(autoincrement())
  service           String
  package           String
  price             Int
  date              DateTime
  start_time        String?
  end_time          String?
  client_name       String
  email             String
  phone             String?
  venue_city        String?
  venue_place       String?
  notes             String?
  promo_code        String?
  gift_card_code    String?
  challenge_id      Int?
  status            String   @default("pending")
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  stripe_session_id String?
  photographer_id   Int?
  client_rating     Int?
  client_review     String?

  // Split payment 50/50
  payment_plan         String?   @default("FULL") @db.VarChar(20)
  deposit_amount       Int?
  deposit_paid_at      DateTime?
  deposit_session_id   String?
  remaining_amount     Int?
  remaining_paid_at    DateTime?
  remaining_session_id String?
  remaining_due_at     DateTime?

  // Foto-Match referral voucher (jeśli klient użył kodu polecającego)
  fm_voucher_code      String?   @db.VarChar(32)

  // Refund / anulowanie
  refund_amount        Int?
  refund_status        String?   @db.VarChar(20)  // PENDING | COMPLETED | FAILED | REJECTED
  refunded_at          DateTime?
  refund_id            String?   @db.VarChar(80)  // PayU refund id
  cancellation_reason  String?   @db.Text
  cancelled_at         DateTime?
  cancelled_by         String?   @db.VarChar(20)  // CLIENT | ADMIN | SYSTEM
  payu_order_id        String?   @db.VarChar(80)  // PayU orderId — potrzebne do refund

  photographer      User?    @relation("PhotographerBookings", fields: [photographer_id], references: [id])
  complaints        BookingComplaint[]

  @@map("bookings")
}

model ServiceType {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  icon        String?
  description String?
  order       Int       @default(0)
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  packages    Package[]

  @@map("service_types")
}

model Package {
  id                Int         @id @default(autoincrement())
  service_id        Int
  name              String
  icon              String?
  description       String?
  hours             Int
  price             Int
  subtitle          String?
  features          String?
  order             Int         @default(0)
  is_active         Boolean     @default(true)
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt
  available_hours   String?
  blocks_entire_day Boolean?
  provider_id       Int?
  users             User?       @relation(fields: [provider_id], references: [id])
  service           ServiceType @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@unique([service_id, name])
  @@map("packages")
}

model GiftCardOrder {
  id                Int       @id @default(autoincrement())
  order_number      String?   @unique
  customer_name     String
  customer_email    String
  amount_paid       Int
  currency          String    @default("PLN")
  payment_status    String    @default("pending")
  payment_method    String?
  stripe_session_id String?
  created_at        DateTime  @default(now())
  paid_at           DateTime?
  card_id           Int
  gift_card_id      Int?
  template_id       Int?
  recipient_email   String?
  recipient_name    String?
  sender_name       String?
  message           String?
  access_token      String?   @unique
  payu_order_id     String?
  user_id           Int?
  gift_card         GiftCard? @relation(fields: [gift_card_id], references: [id])
  user              User?     @relation(fields: [user_id], references: [id])

  @@map("gift_card_orders")
}

model GiftCard {
  id               Int             @id @default(autoincrement())
  code             String          @unique
  amount           Int
  value            Int
  currency         String          @default("PLN")
  valid_until      DateTime?
  is_active        Boolean         @default(true)
  created_at       DateTime        @default(now())
  redeemed_at      DateTime?
  recipient_email  String?
  recipient_name   String?
  notes            String?
  card_template    String?         @default("standard")
  theme            String?         @default("christmas")
  discount_type    String?         @default("amount")
  sender_name      String?
  message          String?
  card_description String?
  card_title       String?
  lowest_price_30d Int?
  status           String          @default("active")
  owner_id         Int?
  orders           GiftCardOrder[]
  owner            User?           @relation("UserGiftCards", fields: [owner_id], references: [id])

  @@map("gift_cards")
}

model User {
  id                      Int                     @id @default(autoincrement())
  email                   String                  @unique
  password_hash           String
  name                    String?
  phone                   String?
  created_at              DateTime                @default(now())
  updated_at              DateTime                @updatedAt
  is_active               Boolean                 @default(true)
  photographer_profile_id Int?                    @unique
  role                    String                  @default("CLIENT")
  last_failed_login       DateTime?
  last_login              DateTime?
  address                 String?
  city                    String?
  postal_code             String?
  reset_token             String?                 @unique
  reset_token_expires     DateTime?
  permissions             Json?
  welcome_email_sent_at   DateTime?
  welcome_email_count     Int                     @default(0)
  baskets                 Basket[]
  assigned_bookings       Booking[]               @relation("PhotographerBookings")
  client_galleries        ClientGallery[]         @relation("ClientGalleries")
  assigned_galleries      ClientGallery[]         @relation("PhotographerGalleries")
  contracts               Contract[]
  orders                  GiftCardOrder[]
  gift_cards              GiftCard[]              @relation("UserGiftCards")
  offers                  Offer[]
  packages                Package[]
  payouts                 payouts[]
  provider_availability   provider_availability[]
  photographer_profile    PhotographerProfile?    @relation(fields: [photographer_profile_id], references: [id])
  crm_activities          CrmActivity[]
  challenge_invites       PhotoChallenge[]        @relation("ChallengeInvitee")
  challenges_initiated    PhotoChallenge[]        @relation("ChallengeInviter")
  foto_match_profile      FotoMatchProfile?

  // Zgody i RODO
  terms_accepted_at       DateTime?
  gdpr_consent_at         DateTime?
  marketing_consent_at    DateTime?
  consent_ip              String?  @db.VarChar(64)
  consent_user_agent      String?  @db.VarChar(255)
  // Soft-delete (Art. 17 RODO) — anonymizujemy email, profile.status='DELETED'
  deleted_at              DateTime?
  deletion_requested_at   DateTime?

  @@map("users")
}

model Offer {
  id                  Int            @id @default(autoincrement())
  slug                String         @unique
  offerNumber         String?        @unique
  title               String
  type                String         @default("b2c")
  category            String?
  status              String         @default("draft")
  valid_until         DateTime?
  client_id           Int?
  client_email        String?
  is_template         Boolean        @default(false)
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt
  pdf_url             String?
  drive_url           String?
  template_data       Json?
  total_price         Int            @default(0)
  client_selection    Json?
  selected_addons     Json?          @default("[]")
  negotiation_enabled Boolean        @default(true)
  client_note         String? // Notatka klienta widoczna dla fotografa
  contract            Contract?
  negotiations        Negotiation[]
  sections            OfferSection[]
  user                User?          @relation(fields: [client_id], references: [id])

  @@map("offers")
}

model OfferSection {
  id          Int         @id @default(autoincrement())
  offer_id    Int
  title       String
  description String?
  order       Int         @default(0)
  items       OfferItem[]
  offer       Offer       @relation(fields: [offer_id], references: [id], onDelete: Cascade)

  @@map("offer_sections")
}

model OfferItem {
  id          Int          @id @default(autoincrement())
  section_id  Int
  title       String
  description String?
  price       Int          @default(0)
  quantity    Int          @default(1)
  is_optional Boolean      @default(false)
  section     OfferSection @relation(fields: [section_id], references: [id], onDelete: Cascade)

  @@map("offer_items")
}

model Contract {
  id              Int       @id @default(autoincrement())
  contract_number String?   @unique
  offer_id        Int?      @unique
  client_id       Int?
  status          String    @default("pending")
  content         String?
  signed_at       DateTime?
  pdf_url         String?
  signed_pdf_url  String? // URL do podpisanego skanu wgranego przez klienta
  drive_url       String?
  client_note     String? // Notatka klienta widoczna dla fotografa
  updated_at      DateTime  @default(now()) @updatedAt
  created_at      DateTime  @default(now())
  user            User?     @relation(fields: [client_id], references: [id])
  offer           Offer?    @relation(fields: [offer_id], references: [id])

  @@map("contracts")
}

model Negotiation {
  id             Int      @id @default(autoincrement())
  offer_id       Int
  message        String?
  proposed_price Int?
  proposed_items String?
  status         String   @default("open")
  sender         String   @default("client") // "client" or "admin"
  created_at     DateTime @default(now())
  offer          Offer    @relation(fields: [offer_id], references: [id])

  @@map("negotiations")
}

model PhotographerProfile {
  id                Int      @id @default(autoincrement())
  bio               String?
  experience_years  Int?
  specialties       String?
  base_commission   Int      @default(15)
  rating            Float    @default(5.0)
  portfolio_enabled Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  avatar_url        String?
  logo_url          String?
  highlight_photos  String?
  user              User?

  @@map("photographer_profiles")
}

model Basket {
  id         String       @id @default(cuid())
  user_id    Int?
  session_id String?      @unique
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  items      BasketItem[]
  user       User?        @relation(fields: [user_id], references: [id])

  @@map("baskets")
}

model BasketItem {
  id         String   @id @default(cuid())
  basket_id  String
  type       String
  product_id String?
  quantity   Int      @default(1)
  price      Int
  metadata   String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  basket     Basket   @relation(fields: [basket_id], references: [id], onDelete: Cascade)

  @@map("basket_items")
}

model SessionInvite {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  inviter_name String
  partner_name String
  occasion     String?
  message      String?
  style        String   @default("romantic")
  is_viewed    Boolean  @default(false)
  created_at   DateTime @default(now())

  @@map("session_invites")
}

model ChallengePackage {
  id                  Int              @id @default(autoincrement())
  name                String
  description         String?
  base_price          Int
  challenge_price     Int
  discount_percentage Int
  included_items      String?
  is_active           Boolean          @default(true)
  display_order       Int              @default(0)
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt
  accent_color        String?          @default("#d4af37")
  bg_color            String?          @default("#18181b")
  gradient_to         String?          @default("#1a1a1a")
  icon                String?
  style_variant       String?          @default("classic")
  challenges          PhotoChallenge[]

  @@map("challenge_packages")
}

model ChallengeLocation {
  id              Int              @id @default(autoincrement())
  name            String
  description     String?
  address         String?
  google_maps_url String?
  image_url       String?
  is_active       Boolean          @default(true)
  display_order   Int              @default(0)
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  challenges      PhotoChallenge[]

  @@map("challenge_locations")
}

model PhotoChallenge {
  id                       Int                      @id @default(autoincrement())
  unique_link              String                   @unique
  inviter_name             String
  inviter_contact          String
  inviter_contact_type     String                   @default("email")
  invitee_name             String
  invitee_contact          String
  invitee_contact_type     String                   @default("email")
  invitee_user_id          Int?
  inviter_user_id          Int?
  package_id               Int
  location_id              Int?
  custom_location          String?
  custom_location_maps_url String?
  discount_amount          Int
  discount_percentage      Int
  status                   String                   @default("sent")
  acceptance_deadline      DateTime?
  created_at               DateTime                 @default(now())
  viewed_at                DateTime?
  accepted_at              DateTime?
  rejected_at              DateTime?
  session_date             DateTime?
  completed_at             DateTime?
  preferred_dates          String?
  admin_notes              String?
  channel                  String?                  @default("messenger")
  inviter_email            String?
  paid_amount              Int?
  payment_id               String?
  payment_method           String?
  payment_status           String?                  @default("pending")
  refund_id                String?
