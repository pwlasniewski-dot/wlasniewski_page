{
  "name": "fotograf-nextjs",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:b2b": "next dev -p 3001",
    "build": "node scripts/pre-build-check.js && node scripts/backup-docs.js && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "migrate": "prisma migrate deploy",
    "seed": "npx prisma db seed",
    "db:backup": "ts-node -P ./tsconfig.json ./prisma/db-management.ts backup",
    "db:restore": "ts-node -P ./tsconfig.json ./prisma/db-management.ts restore",
    "prisma:generate": "prisma generate",
    "prisma:push-LOCAL-ONLY-DANGEROUS": "node scripts/guard-db.js push && prisma generate && prisma db push",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1040.0",
    "@aws-sdk/client-s3": "^3.946.0",
    "@aws-sdk/lib-storage": "^3.946.0",
    "@aws-sdk/s3-request-presigner": "^3.958.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emailjs/browser": "^4.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^5.10.0",
    "@react-pdf/renderer": "^4.3.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/archiver": "^7.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^7.0.4",
    "@types/qrcode": "^1.5.6",
    "archiver": "^7.0.1",
    "basic-ftp": "^5.0.5",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "browser-image-compression": "^2.0.2",
    "canvas-confetti": "^1.9.4",
    "client-zip": "^2.5.0",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.23.22",
    "googleapis": "^170.1.0",
    "html2canvas": "^1.4.1",
    "jose": "^6.1.3",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^3.0.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.462.0",
    "nanoid": "^5.1.6",
    "next": "15.5.7",
    "nodemailer": "^7.0.11",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.67.0",
    "react-hot-toast": "^2.6.0",
    "react-is": "^18.3.1",
    "react-pageflip": "^2.0.3",
    "react-photo-album": "^3.2.1",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "react-to-print": "^3.2.0",
    "recharts": "^3.5.1",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "streamsaver": "^2.0.6",
    "stripe": "^20.0.0",
    "swiper": "^12.0.3",
