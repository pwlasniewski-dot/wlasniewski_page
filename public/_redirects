
# Netlify Redirects
# -----------------
# This file prevents Netlify from automatically redirecting our secondary B2B domain 
# to the primary B2C domain (wlasniewski.pl).

# Canonical host first; Netlify stops at the first matching rule.
/*  https://aeroanaliza.pl/:splat  301!  Host=www.aeroanaliza.pl

# Serve the canonical Aero host directly (don't redirect to the photography domain).
/*  /:splat  200!  Host=aeroanaliza.pl

# Default behavior for other paths is handled by Next.js Middleware
